 "html": "<center>\r\n    <p style=\"width:33%;border-bottom:0px;font-size:18px;text-align:center;\"><b>QUOTATION</b></p>\r\n</center>\r\n\r\n\r\n<div style=\"width: 100%;float: left;border: 1px solid black;\">\r\n    <div style=\"width: 100%;float: left;\">  \r\n        <div style=\"width: 25%;float: left;padding: 0 2px 3px;margin-top: 3px; \">\r\n            <img src=\"/files/images.png\" alt=\"\" style=\"width: 65%;\">\r\n        </div>\r\n        <div style=\"width: 75%;float: right;\">\r\n            <p style=\"font-size: 15px;color: black;font-weight: 600;\">{{doc.company}}</p>\r\n            <p>\r\n                {% set address_doc = frappe.get_doc(\"Address\", doc.company_address) %}\r\n                {% if address_doc %}\r\n                    {{ address_doc.address_line1 or \"\" }}<br>\r\n                    {{ address_doc.address_line2 or \"\" }}<br>\r\n                    {{ address_doc.city or \"\" }}, {{ address_doc.state or \"\" }} - {{ address_doc.pincode or \"\" }}<br>\r\n                    {% if address_doc.email_id %} {{ address_doc.email_id }}<br> {% endif %}\r\n                    {% if address_doc.phone %} Mobile: {{ address_doc.phone }}<br> {% endif %}\r\n                    {% if address_doc.gstin %} GSTIN/UIN: {{ address_doc.gstin }} {% endif %}\r\n                {% endif %}\r\n            </p>\r\n        </div>\r\n    </div>\r\n    <div style=\"width: 100%;float: left;border-top: 1px solid black;\">\r\n        <div style=\"width: 50%;float: left;padding: 0 5px;\">\r\n            <p>Quote No : {{doc.name}}</p>\r\n            <p>Date : {{ frappe.utils.formatdate(doc.transaction_date, \"dd-mm-yyyy\")}}</p>\r\n        </div>\r\n        <div style=\"width: 50%;float: right;padding: 0 5px;\">\r\n            <p>Place of Supply : {{doc.place_of_supply or \"\"}}</p>\r\n        </div>\r\n    </div>\r\n\r\n    <div style=\"width: 100%;float: left;border-top: 1px solid black;background-color: black;padding: 0 5px;\">\r\n        <div style=\"width: 50%;float: left;\">\r\n            <p style=\"font-size: 13px;color: white;text-align: left;font-weight: 600;\">Bill To</p>\r\n        </div>\r\n        <div style=\"width: 50%;float: right;\">\r\n            <p style=\"font-size: 13px;color: white;text-align: left;font-weight: 600;\">\r\n                Ship To\r\n            </p>\r\n        </div>\r\n    </div>\r\n    <div style=\"width: 100%;float: left;padding: 0 5px;\">\r\n\r\n        <div style=\"width: 50%;float: left;\">\r\n            <p>\r\n                <b>{{doc.customer_name}}</b> <br>\r\n                {% if doc.customer_address %}\r\n                {% set address_doc = frappe.get_doc(\"Address\", doc.customer_address) %}\r\n                {{ address_doc.address_line1 or \"\" }}<br>\r\n                {{ address_doc.address_line2 or \"\" }}<br>\r\n                {{ address_doc.city or \"\" }}, {{ address_doc.state or \"\" }} - {{ address_doc.pincode or \"\" }}<br>\r\n                {% if address_doc.email_id %} {{ address_doc.email_id }}<br> {% endif %}\r\n                {% if address_doc.phone %} Mobile: {{ address_doc.phone }}<br> {% endif %}\r\n                {% if address_doc.gstin %} GSTIN/UIN: {{ address_doc.gstin }} {% endif %}\r\n                {% endif %}\r\n            </p>\r\n        </div>\r\n        <div style=\"width: 50%;float: left;\">\r\n            <p>\r\n                <b>{{doc.customer_name}}</b> <br>\r\n                {% if doc.shipping_address_name %}\r\n                {% set address_doc = frappe.get_doc(\"Address\", doc.shipping_address_name) %}\r\n                {{ address_doc.address_line1 or \"\" }}<br>\r\n                {{ address_doc.address_line2 or \"\" }}<br>\r\n                {{ address_doc.city or \"\" }}, {{ address_doc.state or \"\" }} - {{ address_doc.pincode or \"\" }}<br>\r\n                {% if address_doc.email_id %} {{ address_doc.email_id }}<br> {% endif %}\r\n                {% if address_doc.phone %} Mobile: {{ address_doc.phone }}<br> {% endif %}\r\n                {% if address_doc.gstin %} GSTIN/UIN: {{ address_doc.gstin }} {% endif %}\r\n                {% endif %}\r\n            </p>\r\n        </div>\r\n    </div>\r\n    \r\n    <div style=\"width: 100%;float: left;padding: 0 5px;\">\r\n        <table style=\"width: 100%;\">\r\n            <thead style=\"background-color:#333333;\">\r\n                <tr>\r\n                    <td rowspan=2 style=\"text-align:center;border-right:1px solid lightgrey;color:white;font-size: 11px;\">S.No</td>\r\n                    <td rowspan=2 style=\"text-align:center;border-right:1px solid lightgrey;color:white;font-size: 11px;\">Image</td>\r\n                    <td rowspan=2 style=\"text-align:center;border-right:1px solid lightgrey;color:white;font-size: 11px;\">Part No</td>\r\n                    <td rowspan=2 style=\"text-align:center;border-right:1px solid lightgrey;color:white;font-size: 11px;\">Item & Description</td>\r\n                    <td rowspan=2 style=\"text-align:center;border-right:1px solid lightgrey;color:white;font-size: 11px;\">HSN</td>\r\n                    <td style=\"text-align:center;border-right:1px solid lightgrey;color:white;font-size: 11px;\">Weight <br>Kg/Nos</td>\r\n                    <td style=\"text-align:center;border-right:1px solid lightgrey;color:white;font-size: 11px;\">Size</td>\r\n                    <td rowspan=2 style=\"text-align:center;border-right:1px solid lightgrey;color:white;font-size: 11px;\">Qty</td>\r\n                    <td rowspan=2 style=\"text-align:center;border-right:1px solid lightgrey;color:white;font-size: 11px;\">Rate</td>\r\n                    <!--{% if doc.tax_category == \"In-State\"%}-->\r\n                    <!--<td colspan=2 style=\"text-align:center;border-right:1px solid lightgrey;color:white;font-size: 11px;\">CGST</td>-->\r\n                    <!--<td colspan=2 style=\"text-align:center;border-right:1px solid lightgrey;color:white;font-size: 11px;\">SGST</td>-->\r\n                    <!--{% elif doc.tax_category == \"Out-State\"%}-->\r\n                    <!--<td colspan=2 style=\"text-align:center;border-right:1px solid lightgrey;color:white;font-size: 11px;\">IGST</td>-->\r\n                    <!--{%endif%}-->\r\n                    <td style=\"text-align:center;border-right:1px solid lightgrey;color:white;font-size: 11px;\">\r\n                        <nobr style='color:white;font-size: 11px;'>Dis %</nobr>\r\n                    </td>\r\n                    <td rowspan=2 style=\"text-align:center;border-right:1px solid lightgrey;color:white;font-size: 11px;\">Amount</td>\r\n                </tr>\r\n                <!--<tr style=\"line-height:0.4;\">-->\r\n           \r\n                <!--    {% if doc.tax_category == \"In-State\"%}-->\r\n                <!--    <td style=\"text-align:center;border-right:1px solid lightgrey;color:white;font-size: 11px;\">%</td>-->\r\n                <!--    <td style=\"text-align:center;border-right:1px solid lightgrey;color:white;font-size: 11px;\">Rate</td>-->\r\n                <!--    <td style=\"text-align:center;border-right:1px solid lightgrey;color:white;font-size: 11px;\">%</td>-->\r\n                <!--    <td style=\"text-align:center;border-right:1px solid lightgrey;color:white;font-size: 11px;\">Rate</td>-->\r\n                <!--    {% elif doc.tax_category == \"Out-State\"%}-->\r\n                <!--     <td style=\"text-align:center;border-right:1px solid lightgrey;color:white;font-size: 11px;\">%</td>-->\r\n                <!--    <td style=\"text-align:center;border-right:1px solid lightgrey;color:white;font-size: 11px;\">Rate</td>-->\r\n                <!--    {% endif %}-->\r\n                   \r\n                    \r\n                <!--</tr>-->\r\n            </thead>\r\n    \r\n            {% for i in doc.items %}\r\n        <tr>\r\n            <td style='width:3%;border-right:1px solid lightgrey;font-size: 11px;'>{{ loop.index }}</td>\r\n            <td style='width:10%;text-align:center;border-right:1px solid lightgrey;font-size: 11px;'>\r\n                {% if i.image %}\r\n                    <img src=\"{{ i.image }}\" style=\"max-width:50px; max-height:50px;\" >\r\n                {% endif %}\r\n            </td>\r\n            <td style='width:10%;text-align:center;border-right:1px solid lightgrey;font-size: 11px;'>{{ i.item_code }}</td>\r\n            <td style='width:42%;border-right:1px solid lightgrey;font-size: 11px;'>{{ i.item_name }}</td>\r\n            <td style='width:7%;text-align:center;border-right:1px solid lightgrey;font-size: 11px;'>{{ i.gst_hsn_code }}</td>\r\n            \r\n            <td style='width:2%;text-align:center;border-right:1px solid lightgrey;font-size: 11px;'>\r\n                    {{i.total_weight}}</td>\r\n                <td style='width:4%;text-align:center;border-right:1px solid lightgrey;font-size: 11px;'>{{i.custom_size or \"\" }}</td>\r\n            <td style='width:6%;text-align:center;border-right:1px solid lightgrey;font-size: 11px;'>{{ abs(i.qty|int) }}</td>\r\n            <td style='width:10%;text-align:center;border-right:1px solid lightgrey;font-size: 11px;'>{{ i.rate }}</td>\r\n            {% if doc.tax_category == \"In-State\"%}\r\n            <!--<td style='text-align:center;border-right:1px solid lightgrey;font-size: 11px;'>{{\"%.0f\" %i.cgst_rate}}</td>-->\r\n            <!--<td style='text-align:center;border-right:1px solid lightgrey;font-size: 11px;'>{{\"%.2f\" %i.cgst_amount}}</td>-->\r\n            <!--<td style='text-align:center;border-right:1px solid lightgrey;font-size: 11px;'>{{\"%.0f\" %i.sgst_rate}}</td>-->\r\n            <!--<td style='text-align:center;border-right:1px solid lightgrey;font-size: 11px;'>{{\"%.2f\" %i.sgst_amount}}</td>-->\r\n            <!--{% elif doc.tax_category == \"Out-State\"%}-->\r\n            <!-- <td style='text-align:center;border-right:1px solid lightgrey;font-size: 11px;'>{{\"%.0f\" %i.igst_rate}}</td>-->\r\n            <!--<td style='text-align:center;border-right:1px solid lightgrey;font-size: 11px;'>{{\"%.2f\" %i.igst_amount}}</td>-->\r\n            <!--{% endif %}-->\r\n            <td style='width:18%;text-align:center;border-right:1px solid lightgrey;font-size: 11px;'><nobr>{{ frappe.utils.fmt_money(abs(i.amount),currency='INR') }}</nobr></td>\r\n        </tr>\r\n        {% endfor %}\r\n        <tr>\r\n            <td style='width:22%;text-align:left;border-right:1px solid lightgrey;font-size: 11px;' colspan=\"5\">Total Net Weight</td>\r\n            <td style='width:22%;text-align:left;border-right:1px solid lightgrey;font-size: 11px;' colspan=\"6\">{% if doc.total_net_weight %} {{doc.total_net_weight}} {% endif %}</td>\r\n        </tr>\r\n        </table>\r\n    </div>\r\n    {% set tax_details = get_tax_table_sales_invoice(doc.doctype,doc.name) %}\r\n    <div style=\"width: 100%;float: left;margin-top: 5px;border-top: 1px solid black;\">\r\n        <div style=\"width: 50%;float: left;margin-top: 5px;padding: 0 5px;\">\r\n            <b>In Words:</b><br>{{doc.in_words}}\r\n        </div>\r\n        <div style=\"margin-top: 5px;padding: 0 5px;width: 50%;float: right;\">\r\n            <div style=\"width: 50%;float: left;\">\r\n                <p style=\"text-align: left;\">\r\n                </p>\r\n            </div>\r\n            <div style=\"width: 50%;float: right;\">\r\n                {% set ns = namespace(total_sgst=0, total_cgst=0, total_igst=0) %}\r\n                {% for row in tax_details.tax_rows %}\r\n                {% set ns.total_cgst = ns.total_cgst + row[3] %}\r\n                {% set ns.total_sgst = ns.total_sgst + row[5] %}\r\n                {% set ns.total_igst = ns.total_igst + row[7] %}\r\n                {% endfor %}\r\n                {% if tax_details.tax_category == 'In-State' %}\r\n                <p style=\"text-align: right;\"><b>CGST : \u20b9{{ abs(ns.total_cgst) | round(2)}}</b></p>\r\n                <p style=\"text-align: right;\"><b>SGST : \u20b9{{ abs(ns.total_sgst) | round(2)}}</b></p>\r\n                {% else %}\r\n                <p style=\"text-align: right;\"><b>IGST : \u20b9{{ abs(ns.total_igst) | round(2)}}</b></p>\r\n                {% endif %}\r\n                <p style=\"text-align: right;\"> <b>Adjustment : \u20b9{{ abs(doc.rounding_adjustment) | round(2) }}</b></p>\r\n                <p style=\"text-align: right;\"><b>Total : \u20b9{{ abs(doc.grand_total) | round(2) }}</b></p>                \r\n            </div>\r\n        </div>\r\n    </div>\r\n    {% if not doc.is_return %}\r\n\r\n    <div style=\"font-size:15px;background-color:#333;width: 100%;float: left;\">\r\n        <b style=\"color:white;\"> Bank Details</b>\r\n    </div>\r\n    <div style=\"width: 100%;float: left;border-top: 1px solid black;\">\r\n        <div style=\"width: 50%;float: left;\">\r\n            <div style=\"width: 100%; overflow: hidden; font-size: 12px; line-height: 1.5;\">\r\n                {% set branch = frappe.get_doc(\"Branch\", doc.branch) if doc.branch else None %}\r\n        \r\n                {% if branch and branch.custom_company_wise_account_table %}\r\n\r\n                {% for row in branch.custom_company_wise_account_table %}\r\n                    {% if row.company == doc.company and row.custom_use_in_print_format == 1 %}\r\n\r\n                        {% if row.bank_account %}\r\n                            {% set bank_account = frappe.get_doc(\"Bank Account\", row.bank_account) %}\r\n                        {% else %}\r\n                            {% set bank_account = None %}\r\n                        {% endif %}\r\n\r\n                        {% if bank_account %}\r\n                        <!-- Bank Name -->\r\n                        <div style=\"float: left; padding: 2px; text-align: left;\">\r\n                            {% if bank_account.bank_account_no %}\r\n                            <div><strong>Account Number</strong></div>\r\n                            {% endif %}\r\n                            {% if bank_account.bank %}\r\n                            <div><strong>Bank Name</strong></div>\r\n                            {% endif %}\r\n                            {% if bank_account.branch_code %}\r\n                            <div><strong>IFSC Code</strong></div>\r\n                            {% endif %}\r\n                            {% if bank_account.custom_branch_name %}\r\n                            <div><strong>Branch</strong></div>\r\n                            {% endif %}\r\n                        </div>\r\n\r\n                        <!-- Bank Details -->\r\n                        <div style=\"float: left; padding: 2px; text-align: left;\">\r\n                            {% if bank_account.bank_account_no %}\r\n                            <div><b>&nbsp; :</b>&nbsp;{{ bank_account.bank_account_no }}</div>\r\n                            {% endif %}\r\n                            {% if bank_account.bank %}\r\n                            <div><b>&nbsp; :</b>&nbsp;{{ bank_account.bank }}</div>\r\n                            {% endif %}\r\n                            {% if bank_account.branch_code %}\r\n                            <div><b>&nbsp; :</b>&nbsp;{{ bank_account.branch_code }}</div>\r\n                            {% endif %}\r\n                            {% if bank_account.custom_branch_name %}\r\n                            <div><b>&nbsp; :</b>&nbsp;{{ bank_account.custom_branch_name }}</div>\r\n                            {% endif %}\r\n                        </div>\r\n\r\n                        <div style=\"clear: both;\"></div>\r\n                        {% else %}\r\n                        <!-- Message if no bank account is linked -->\r\n                        <div style=\"padding: 5px; color: red; font-weight: bold;\">\r\n                            Kindly update the bank details.\r\n                        </div>\r\n                        {% endif %}\r\n                {% endif %}\r\n                {% endfor %}\r\n                </div>\r\n                {% else %}\r\n                <!-- Message if no branch is linked -->\r\n                <div style=\"padding: 5px; color: red; font-weight: bold;\">\r\n                    Kindly update the branch details.\r\n                </div>  \r\n            {% endif %}\r\n        </div>\r\n        <div style=\"width: 50%;float: right;\">\r\n            {% if doc.branch %}\r\n                {% set branch = frappe.get_doc(\"Branch\", doc.branch) %}\r\n                    {% for row in branch.custom_company_wise_account_table %}\r\n                        {% if row.company == doc.company and row.custom_use_in_print_format == 1 %}\r\n                            {% set bank_account = frappe.get_doc(\"Bank Account\", row.bank_account) if row.bank_account else None %}\r\n                                <p>\r\n                                    {% if not doc.is_return %}\r\n                                       {% if bank_account.custom_qr_code %}\r\n                                            <img src=\"{{ frappe.utils.get_url() }}{{ bank_account.custom_qr_code }}\" style=\"width: 100px; height: 100px;float: right;\">\r\n                                        {% else %}\r\n                                            <p>No QR Code Available</p>\r\n                                        {% endif %}\r\n                                    {% endif %}\r\n                                </p>\r\n                        {% endif %}\r\n                    {% endfor %}\r\n                {% else %}\r\n                    <p>No QR Code Available</p>\r\n                {% endif %}\r\n        </div>\r\n    </div>\r\n    {% endif %}\r\n    <div style=\"width: 100%;float: left;\">\r\n        <table style=\"width: 100%;\">\r\n            <tr>\r\n                <td colspan=\"7\" style=\"font-size: 12px;\"><b style=\"font-size:12px;\">\r\n                    {% if not doc.is_return %}\r\n                        Terms and Conditions:</b><br>\r\n                        Payment made by cash to company staff's will not be considered as payment<br>\r\n                        & not responsible for that amount<br>\r\n                        <div style='font-size:12px;border-top:0px;border-right:0px;width:75%;'><b>Only\r\n                                payment made on cheque/NEFT/RTGS</b></div>\r\n                        Goods once accepted will not be taken back in cash discripancy it should returned with in 7 days\r\n                    {% else %}\r\n                    <p>&nbsp;</p>\r\n                    {% endif %}\r\n                </td>\r\n                <td colspan='4' style=\"text-align:right;font-size: 12px;\">\r\n                    <b>For {{doc.company}}</b>\r\n                    <br><br><br><br>\r\n                    Authorised Signatory\r\n                </td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n</div>",
