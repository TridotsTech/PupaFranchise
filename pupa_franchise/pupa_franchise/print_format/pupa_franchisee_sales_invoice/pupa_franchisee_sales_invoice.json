 "css": "/*tr{*/\n/*    border:1px solid lightgrey;*/\n/*}*/\n/*@page */\n/*{*/\n/*    margin-top: 3cm;*/\n    margin-bottom: 2.4cm/* Adjust the value as per your letterhead size */\n/*}*/\n/*.print-format td*/\n/*{*/\n/*    padding:4px !important;*/\n/*}*/",
