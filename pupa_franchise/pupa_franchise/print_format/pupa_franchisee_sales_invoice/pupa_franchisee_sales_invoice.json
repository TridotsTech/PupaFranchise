 "doc_type": "Sales Invoice",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!-- {% if not doc.is_return %}\r\n    <center>\r\n        <p style=\"width:33%;border-bottom:0px;font-size:18px;text-align:center;\"><b>INVOICE</b></p>\r\n    </center>\r\n    {% else %}\r\n    <center>\r\n        <p style=\"width:33%;border-bottom:0px;font-size:18px;text-align:center;\"><b>CREDIT NOTE</b></p>\r\n    </center>\r\n    {% endif %} -->\r\n\r\n\r\n<div style=\"width: 100%;float: left;border: 1px solid black;\">\r\n    <div style=\"width: 100%;float: left;\">\r\n        <div style=\"width: 17%;float: left;padding: 5px 5px;\">\r\n            <img src=\"/files/images.png\" alt=\"\" style=\"width:90%;margin-top:10px;\">\r\n        </div>\r\n        <div style=\"width: 40%;float: left;padding: 0 5px;\">\r\n            <p><b><span style=\"font-size: 18px;\">{{ doc .company }} {% if doc.is_internal_customer != 1 %}</span>{%\r\n                    if doc.branch %} <br> <span style='font-size:15px'>{{doc.branch or \"\"}}</span>{% endif %} {%\r\n                    endif %}</b><br>\r\n            </p>\r\n            <p>\r\n                {% if doc.branch %}\r\n                {% set branch = frappe.get_doc(\"Branch\", doc.branch) %}\r\n                {% set ns = namespace(address=None) %}\r\n\r\n                {% for table in branch.custom_company_wise_address_table %}\r\n                {% if table.company == doc.company %}\r\n                {% set ns.address = table.address %}\r\n                {% endif %}\r\n                {% endfor %}\r\n\r\n                {% if ns.address %}\r\n                {% set address_doc = frappe.get_doc(\"Address\", ns.address) %}\r\n                {{ address_doc.address_line1 or \"\" }}<br>\r\n                {{ address_doc.address_line2 or \"\" }}<br>\r\n                {{ address_doc.city or \"\" }}, {{ address_doc.state or \"\" }} - {{ address_doc.pincode or \"\" }}<br>\r\n                {% if address_doc.email_id %} {{ address_doc.email_id }}<br> {% endif %}\r\n                {% if address_doc.phone %} Mobile: {{ address_doc.phone }}<br> {% endif %}\r\n                {% if address_doc.gstin %} GSTIN/UIN: {{ address_doc.gstin }} {% endif %}\r\n                {% endif %}\r\n                {% endif %}\r\n            </p>\r\n        </div>\r\n        <div style=\"width: 30%;float: right;\">\r\n            <!-- {% if doc.irn %}\r\n                    {% set e_invoice_log = frappe.db.get_value( \"e-Invoice Log\", doc.irn,\r\n                    (\"invoice_data\", \"signed_qr_code\"), as_dict=True ) %}\r\n                    <div style=\"padding-bottom:5px !important;padding: 0 5px;padding-top: 5px;float: right;\">\r\n                        <img width='120px' height='120px'\r\n                            src=\"data:image/png;base64,{{ get_qr_code(e_invoice_log.signed_qr_code, scale=2) }}\"\r\n                            class=\"qrcode\">\r\n\r\n                    </div>\r\n                    {% else %}\r\n\r\n                    {% endif %} -->\r\n            <p style=\"font-size: 15px;\r\n        color: black;\r\n        font-weight: 600;\r\n        text-align: center;\r\n        position: relative;\r\n        top: 54px;\">INVOICE</p>\r\n        </div>\r\n    </div>\r\n    <div style=\"width: 100%;float: left;border-top: 1px solid black;\">\r\n        <div style=\"width: 50%;float: left;padding: 0 5px;\">\r\n            <!-- {% if not doc.is_return %}\r\n                <p>Invoice No :{{doc.name}}</p>\r\n                {% else %}\r\n                <p>Credit Note No :<b>{{doc.name}}</b></p>\r\n                {% endif %}\r\n                <p>\r\n                    {% if doc.is_return and doc.custom_original_invoice_number %}\r\n                        Original Invoice No :<b> {{doc.custom_original_invoice_number or \"-\"}}</b>\r\n                    {% endif %}\r\n                </p>\r\n                {% if doc.irn %}\r\n                {% set ack_no = frappe.db.get_all('e-Invoice Log', filters={'reference_doctype':'Sales Invoice','reference_name':doc.name}, fields=['acknowledgement_number']) %}\r\n                {% if ack_no %}\r\n                <p>\r\n                    Ack.No : <b>{{ack_no[0]['acknowledgement_number']}}</b>\r\n                </p>\r\n                {% endif %}\r\n                {% endif %}\r\n                <p>\r\n                    {% if doc.irn %}\r\n                        IRN No : <b>{{doc.irn}}</b>\r\n                    {% endif %}\r\n                </p>\r\n                <p>\r\n                    {% if doc.ewaybill %}\r\n                    <p>Eway-bill No: {{doc.ewaybill}} </p>\r\n                    {% endif %}\r\n                </p> -->\r\n            <p style=\"font-size: 15px;color: black; font-weight: 600;text-align: left;\">Invoice Number :\r\n                <b>{{doc.name}}</b>\r\n            </p>\r\n        </div>\r\n        <div style=\"width: 50%;float: right;padding: 0 5px;\">\r\n            <!-- <p style=\"text-align:right;\"><mark style=\"background-color:lightgray;\">Date : {{ frappe.utils.formatdate(doc.posting_date, \"dd-mm-yyyy\")}}\r\n                {% set formatted_time = frappe.utils.get_time(doc.posting_time).strftime('%I:%M %p') %}\r\n                {{ formatted_time }}</mark>\r\n            </p>\r\n            \r\n            <p style=\"text-align: right;\">\r\n                Buyer Order No :<b> {{doc.custom_buyer_order_no or \"-\"}}</b>\r\n            </p> -->\r\n            <p style=\"font-size: 15px;color: black;text-align: left;\">\r\n                {% if doc.sales_team %}\r\n                Sales Person: <b>{{doc.sales_team[0].sales_person}}</b>\r\n                Contact: <b>{{doc.sales_team[0].custom_mobile_number}}</b>\r\n                {% endif %}\r\n            </p>\r\n            <p style=\"font-size: 15px;color: black;text-align: left;\">\r\n                Invoice Time: <b>{{ frappe.utils.getdate(doc.posting_date).strftime(\"%d/%m/%Y\") if doc.posting_date else \"\" }}\r\n                    {{frappe.utils.get_time(doc.posting_time).strftime(\"%I:%M %p\")}}</b>\r\n            </p>\r\n        </div>\r\n    </div>\r\n    {% if doc.customer_address %}\r\n    {% set billing_add = frappe.get_doc(\"Address\", doc.customer_address) %}\r\n    {% endif %}\r\n    {% if doc.shipping_address_name %}\r\n    {% set shipping_add = frappe.get_doc(\"Address\", doc.shipping_address_name) %}\r\n    {% endif %}\r\n    {%if doc.dispatch_address_name %}\r\n    {% set dispatch_add = frappe.get_doc(\"Address\", doc.dispatch_address_name) %}\r\n    {% endif %}\r\n\r\n    <div style=\"width: 100%;float: left;border-top: 1px solid black;background-color: lightgray;padding: 0 5px;\">\r\n        <!-- <div style=\"width: 50%;float: left;\"> -->\r\n        <p style=\"font-size: 13px;color: white;text-align: left;font-weight: 600;\">Customer</p>\r\n        <!-- </div> -->\r\n        <!-- <div style=\"width: 50%;float: right;\">\r\n                <p style=\"font-size: 13px;color: white;text-align: left;font-weight: 600;\">\r\n                    {% if dispatch_add %}\r\n                        Dispatch From\r\n                    {% elif shipping_add %}\r\n                        Ship To\r\n                    {% endif %}\r\n                </p>\r\n            </div> -->\r\n    </div>\r\n\r\n    <div style=\"width: 100%;float: left;padding: 0 5px;\">\r\n        <!-- <div style=\"width: 50%;float: left;\"> -->\r\n        <p>\r\n            <b>{{doc.customer_name }}</b> <br>\r\n            {% if billing_add %}\r\n            {{ billing_add.address_line1 or \"\" }}<br>\r\n            {% if billing_add.address_line2 %} {{ billing_add.address_line2 }}<br> {% endif %}\r\n            {{ billing_add.city or \"\" }}<br>\r\n            {{ billing_add.state or \"\" }} - {{ billing_add.pincode or \"\" }}<br>\r\n            {% if billing_add.gstin %} GSTIN/UIN: {{ billing_add.gstin }}<br> {% endif %}\r\n            {% if billing_add.phone %} Mobile: {{ billing_add.phone }}{% elif\r\n            frappe.db.get_value('Customer',doc.customer,'mobile_no') %} Mobile: {{\r\n            frappe.db.get_value('Customer',doc.customer,'mobile_no') }}<br> {% endif %}\r\n\r\n            {% endif %}\r\n        </p>\r\n        <!-- </div>\r\n            <div style=\"width: 50%;float: left;\">\r\n                <p>\r\n                    {% if dispatch_add %}\r\n                        <b>{{dispatch_add.address_title}}</b>\r\n                        <br>\r\n                        {{ dispatch_add.address_line1 or \"\" }}<br>\r\n                        {% if dispatch_add.address_line2 %} {{ dispatch_add.address_line2 }}<br> {% endif %}\r\n                        {{ dispatch_add.city or \"\" }}<br>\r\n                        {{ dispatch_add.state or \"\" }} - {{ dispatch_add.pincode or \"\" }}<br>\r\n                        {% if dispatch_add.gstin %} GSTIN/UIN: {{ dispatch_add.gstin }}<br> {% endif %}\r\n                        {% if dispatch_add.phone %} Mobile: {{ dispatch_add.phone }}<br> {% endif %}\r\n                    {% elif shipping_add %}\r\n                        <b>{{doc.customer }}</b>\r\n                        <br>\r\n                        {{ shipping_add.address_line1 or \"\" }}<br>\r\n                        {% if shipping_add.address_line2 %} {{ shipping_add.address_line2 }}<br> {% endif %}\r\n                        {{ shipping_add.city or \"\" }}<br>\r\n                        {{ shipping_add.state or \"\" }} - {{ shipping_add.pincode or \"\" }}<br>\r\n                        {% if shipping_add.gstin %} GSTIN/UIN: {{ shipping_add.gstin }} {% endif %}\r\n                        {% if shipping_add.phone %} Mobile: {{ shipping_add.phone }}<br> {% endif %}\r\n                    {% endif %}\r\n                </p>\r\n            </div> -->\r\n    </div>\r\n    {% set ns = namespace(total_size=0) %}\r\n    <div style=\"width: 100%;float: left;padding: 0 5px;\">\r\n        <table style=\"width: 100%;\">\r\n            <thead style=\"background-color:#333333;\">\r\n                <tr>\r\n                    <td style=\"text-align:center;border-right:1px solid lightgrey;color:white;font-size: 11px;\">S.No\r\n                    </td>\r\n                    <td style=\"text-align:center;border-right:1px solid lightgrey;color:white;font-size: 11px;\"\r\n                        colspan=\"2\">Item & Description</td>\r\n                    <td style=\"text-align:center;border-right:1px solid lightgrey;color:white;font-size: 11px;\">HSN/SAC\r\n                    </td>\r\n                    <td style=\"text-align:center;border-right:1px solid lightgrey;color:white;font-size: 11px;\">Qty</td>\r\n                    <td style=\"text-align:center;border-right:1px solid lightgrey;color:white;font-size: 11px;\">MRP</td>\r\n                    <td style=\"text-align:center;border-right:1px solid lightgrey;color:white;font-size: 11px;\">Rate\r\n                    </td>\r\n                    <td style=\"text-align:center;border-right:1px solid lightgreyk;color:white;font-size: 11px;\">\r\n                        Amount<br>(\u20b9)</td>\r\n                </tr>\r\n            </thead>\r\n\r\n            {% for i in doc.items %}\r\n            {% if i.custom_size %}\r\n            {% set size = i.custom_size | replace(\",\", \"\") | float | round(4) %}\r\n            {% set ns.total_size = ns.total_size + size | round(4) %}\r\n            {% endif %}\r\n            <tr>\r\n                <td style='border:1px solid lightgrey;font-size: 11px;'>{{ loop.index }}</td>\r\n                <td style='text-align:center;border:1px solid lightgrey;font-size: 11px;'>\r\n                    {% if i.image %}\r\n                    <img src=\"{{ i.image }}\" style=\"max-width:50px; max-height:50px;\">\r\n                    {% else %}\r\n\r\n                    {% endif %}\r\n                </td>\r\n                <td style='text-align:center;border:1px solid lightgrey;font-size: 11px;width: 30%;'>{{\r\n                    i.description or \"\"}}</td>\r\n                <td style='text-align:center;border:1px solid lightgrey;font-size: 11px;'>{{ i.gst_hsn_code or\r\n                    \"\"}}</td>\r\n\r\n                <td style='text-align:center;border:1px solid lightgrey;font-size: 11px;'>{{ abs(i.qty|int) }}\r\n                </td>\r\n                <td style='text-align:center;border:1px solid lightgrey;font-size: 11px;'>{{ i.custom_mrp or \"\" }}\r\n                </td>\r\n                <td style='text-align:center;border:1px solid lightgrey;font-size: 11px;'>{{ i.price_list_rate or \"\" }}</td>\r\n                <td\r\n                    style='text-align:center;border:1px solid lightgrey;font-size: 11px;padding-left:35px !important;'>\r\n                    {{ frappe.utils.fmt_money(abs(i.amount)) }}\r\n                </td>\r\n\r\n            </tr>\r\n            {% endfor %}\r\n\r\n        </table>\r\n    </div>\r\n    <div style=\"width: 100%;float: left;margin-top: 5px;border-top: 1px solid black;\">\r\n        <div style=\"width: 50%;float: left;margin-top: 5px;padding: 0 5px;\">\r\n            <b>In Words:</b><br>{{doc.in_words}} <br>\r\n            <p style=\"font-size: 13px;color: black;text-align: left;font-weight: 600;\">Bank Details</p>\r\n\r\n            {% set branch = frappe.get_doc(\"Branch\", doc.branch) if doc.branch else None %}\r\n            {% for row in branch.custom_company_wise_account_table %}\r\n\r\n            {% if row.company == doc.company %}\r\n\r\n            {% if row.bank_account %}\r\n            {% set bank_account = frappe.get_doc(\"Bank Account\", row.bank_account) %}\r\n            {% else %}\r\n            {% set bank_account = None %}\r\n            {% endif %}\r\n\r\n            {% if bank_account %}\r\n            <!-- Bank Name -->\r\n\r\n            <p style=\"font-size: 13px;color: black;text-align: left;\">\r\n                <b>Account Number : </b>\r\n                {% if bank_account.bank_account_no %} {{ bank_account.bank_account_no }} {% endif %}\r\n            </p>\r\n            <p style=\"font-size: 13px;color: black;text-align: left;\">\r\n                {% if bank_account.bank %}\r\n                <b>Account Number : </b>\r\n                {% endif %}\r\n\r\n                {% if bank_account.bank %} {{ bank_account.bank }} {% endif %}\r\n            </p>\r\n            <p style=\"font-size: 13px;color: black;text-align: left;\">\r\n                {% if bank_account.branch_code %}\r\n                <b>IFSC Code : </b>\r\n                {% endif %}\r\n\r\n                {% if bank_account.branch_code %} {{ bank_account.branch_code }} {% endif %}\r\n            </p>\r\n            <p style=\"font-size: 13px;color: black;text-align: left;\">\r\n                {% if bank_account.custom_branch_name %}\r\n                <b>Branch : </b>\r\n                {% endif %}\r\n\r\n                {% if bank_account.branch_code %} {{ bank_account.branch_code }} {% endif %}\r\n            </p>\r\n            \r\n            {% else %}\r\n            <!-- Message if no bank account is linked -->\r\n            <div style=\"padding: 5px; color: red; font-weight: bold;\">\r\n                Kindly update the bank details.\r\n            </div>\r\n            {% endif %}\r\n            {% endif %}\r\n            {% endfor %}\r\n            <!-- terms -->\r\n             <p style=\"font-size: 13px;color: black;text-align: left;font-weight: 600;\">Terms and Conditions</p>\r\n             <p style=\"font-size: 13px;color: black;text-align: left;\">\r\n                 Goods Delivered in Good Condition,incase any issue.It should be informed immediately.\r\n            </p>\r\n            \r\n        </div>\r\n\r\n        {% set tax_rates = {\"cgst\":\"\", \"sgst\":\"\", \"igst\":\"\"}%}\r\n        {% for i in doc.taxes %}\r\n        {% if \"CGST\" in i.account_head %}\r\n        {% set _ = tax_rates.update({\"cgst\":i.rate}) %}\r\n        {% elif \"SGST\" in i.account_head %}\r\n        {% set _ = tax_rates.update({\"sgst\": i.rate}) %}\r\n        {% elif \"IGST\" in i.account_head %}\r\n        {% set _ = tax_rates.update({\"igst\":i.rate}) %}\r\n        {% endif %}\r\n        {% endfor %}\r\n        {% set tax_details = get_tax_table_sales_invoice(doc.doctype,doc.name) %}\r\n        <div style=\"width: 50%;float: right;border-left: 1px solid black;height: 233px;\">\r\n            <div style=\"margin-top: 5px;padding: 0 5px;width: 100%;float: right;border-bottom: 1px solid black;\">\r\n                <p style=\"text-align: right;\">Net Value <b>\u20b9{{ abs(doc.net_total) | round(2) }}</b></p>\r\n                {% set ns = namespace(total_sgst=0, total_cgst=0, total_igst=0) %}\r\n                {% for row in tax_details.tax_rows %}\r\n                {% set ns.total_cgst = ns.total_cgst + row[3] %}\r\n                {% set ns.total_sgst = ns.total_sgst + row[5] %}\r\n                {% set ns.total_igst = ns.total_igst + row[7] %}\r\n                {% endfor %}\r\n                {% if tax_details.tax_category == 'In-State' %}\r\n                <p style=\"text-align: right;\"><b>CGST({{tax_rates.cgst}})% : \u20b9{{ abs(ns.total_cgst) | round(2)}}</b></p>\r\n                <p style=\"text-align: right;\"><b>SGST({{tax_rates.sgst}})% : \u20b9{{ abs(ns.total_sgst) | round(2)}}</b></p>\r\n                {% else %}\r\n                <p style=\"text-align: right;\"><b>IGST({{tax_rates.igst}})% : \u20b9{{ abs(ns.total_igst) | round(2)}}</b></p>\r\n                {% endif %}\r\n                {% if doc.rounding_adjustment %}\r\n                <p style=\"text-align: right;\">Adjustment : <b>\u20b9{{ doc.rounding_adjustment | round(2) }}</b></p>\r\n                {% endif %}\r\n                <p style=\"text-align: right;\">Total : <b>\u20b9{{ doc.rounded_total | round(2) }}</b></p>\r\n            </div>\r\n            <div style=\"margin-top: 5px;padding: 0 5px;width: 100%;float: right;\">\r\n                <p\r\n                    style=\"font-size: 13px;color: black;font-weight: 600;text-align: center;position: relative;top: 113px;\">\r\n                    Authorized Signature</p>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n</div>",
